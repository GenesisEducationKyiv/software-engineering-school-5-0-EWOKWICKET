{
  "name": "weather-forecast",
  "version": "1.0.0",
  "author": "Hushchin Ivan",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "rimraf dist && yarn workspace weather build && yarn workspace notifications build && yarn workspace subscription build && yarn workspace gateway build",
    "start:dev": "concurrently -n gateway,notifications,weather,subscription -c blue,green,cyan,magenta \"yarn workspace gateway start:dev\" \"yarn workspace notifications start:dev\" \"yarn workspace weather start:dev\" \"yarn workspace subscription start:dev\"",
    "start:prod": "concurrently -n gateway,notifications,weather,subscription -c blue,green,cyan,magenta \"yarn workspace gateway start:prod\" \"yarn workspace notifications start:prod\" \"yarn workspace weather start:prod\" \"yarn workspace subscription start:prod\"",
    "lint": "yarn workspaces run lint",
    "format": "yarn workspaces run format",
    "build:test": "nest build --config nest-cli.test.json",
    "start:test": "node dist/test/main.test",
    "migrate": "yarn workspace subscription migrate",
    "migrate:test": "yarn workspace subscription migrate:test",
    "test:integration": "jest --config test/jest-integration.config.js",
    "test:e2e": "playwright test",
    "test:architecture": "jest --config test/jest-architecture.config.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:integration": "docker compose -f ../../docker-compose.test.yml up --build --abort-on-container-exit integration-test",
    "docker:e2e": "docker compose -f ../../docker-compose.test.yml up --build --abort-on-container-exit e2e-test",
    "docker:architecture": "docker compose -f ../../docker-compose.test.yml up --build --abort-on-container-exit architecture-test",
    "docker:test:clear": "docker compose -f ../../docker-compose.test.yml down"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "axios": "^1.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.28.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "^1.54.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsarch": "^5.4.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
