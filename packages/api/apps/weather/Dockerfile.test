FROM node:22.15.1-alpine

WORKDIR /app

# Root
COPY package.json yarn.lock tsconfig*.json ./
COPY test ./test

# Weather
COPY apps/weather/package.json ./apps/weather/package.json
COPY apps/weather/nest-cli.test.json ./apps/weather/nest-cli.test.json
COPY apps/weather/tsconfig*.json ./apps/weather/

COPY apps/weather ./apps/weather
COPY libs ./libs

RUN yarn install --frozen-lockfile
RUN yarn workspace weather build:test

EXPOSE 3003