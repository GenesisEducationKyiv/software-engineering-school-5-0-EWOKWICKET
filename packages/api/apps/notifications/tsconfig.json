{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "target": "ES2023",
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "baseUrl": "../../",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest"],
    "paths": {
      "@common/*": ["libs/common/src/*"],
      "@metrics/*": ["libs/metrics/src/*"],
      "@cache/*": ["libs/cache/src/*"],
      "@proto/*": ["libs/proto/generated/*"],
      "src/*": ["apps/notifications/src/*"]
    }
  },
  "include": ["src/**/*.ts", "assets/**/*"]
}
