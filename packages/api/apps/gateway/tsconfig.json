{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "target": "ES2023",
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "baseUrl": "../../",
    "paths": {
      "@common/*": ["libs/common/src/*"],
      "@proto/*": ["libs/proto/generated/*"],
      "src/*": ["apps/gateway/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../libs/common/src/clients/clients.config.ts"]
}
